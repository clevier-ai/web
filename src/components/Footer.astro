---
import LinkedInLink from "./LinkedInLink.astro";
import { copy, langs, routes, type Lang, type PageId } from "../i18n/ui";

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
const t = copy[lang];
const year = new Date().getFullYear();
const legal = (["notice", "privacy", "cookies"] as const).map((id) => ({
  id,
  href: routes[lang][id],
  label: t.legalNav[id],
}));
// "/?lang=es" evita la redirección automática por idioma del navegador.
const hrefFor = (code: Lang) => (code === "es" && page === "home" ? "/?lang=es" : routes[code][page]);
---

<footer class="footer">
  <div class="wrap footer__inner">
    <a class="footer-brand" href={routes[lang].home} aria-label="Clevier">
      <img src="/brand/cl-angle-67deg.svg" alt="" width="28" height="24" />
      <span>evier</span>
    </a>

    <div class="footlinks">
      <nav class="langs" aria-label={t.languages}>
        {
          langs.map((code) =>
            code === lang ? (
              <span lang={code} aria-current="page">
                {code.toUpperCase()}
              </span>
            ) : (
              <a class="enlace" href={hrefFor(code)} hreflang={code} lang={code}>
                {code.toUpperCase()}
              </a>
            ),
          )
        }
      </nav>
      <LinkedInLink label={t.linkedin} text />
    </div>
    <nav class="legal" aria-label={t.legalLabel}>
      {
        legal.map((item) => (
          <a class="enlace" href={item.href} aria-current={page === item.id ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <p class="copy">© {year} Clevier · Barcelona</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 28px 48px;
    border-top: 1px solid var(--clv-border);
  }

  .footer__inner {
    display: grid;
    gap: 4px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: flex-end;
    gap: 0;
    margin-bottom: 4px;
    text-decoration: none;
    color: var(--clv-text);
  }

  .footer-brand img,
  .footer-brand span {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .footer-brand:hover img,
  .footer-brand:hover span {
    transform: translateY(-2px);
  }

  .footer-brand img {
    height: 1.15em;
    width: auto;
    font-size: 20px;
    margin-right: var(--clv-lockup-gap);
  }

  .footer-brand span {
    font-family: var(--clv-font-display);
    font-weight: 700;
    font-size: 20px;
    font-variation-settings: "SOFT" 30, "opsz" 20, "wght" 700;
    letter-spacing: var(--clv-lockup-tracking);
    line-height: 1;
  }

  .footlinks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-top: 8px;
  }

  .langs {
    display: flex;
    align-items: center;
  }

  .langs a,
  .langs span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 8px;
    color: var(--clv-text-secondary);
    font: var(--clv-text-label);
    letter-spacing: 0.06em;
  }

  .langs a:hover,
  .langs [aria-current="page"] {
    color: var(--clv-text);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 8px;
  }

  .legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--clv-text-secondary);
    font: var(--clv-text-small);
  }

  .legal a:hover,
  .legal a[aria-current="page"] {
    color: var(--clv-text);
  }

  .legal a[aria-current="page"] {
    text-decoration-color: currentColor;
  }

  .copy {
    color: var(--clv-text-secondary);
    font: var(--clv-text-small);
  }

  @media (max-width: 799px) {
    .footer {
      padding-block: 2rem 3.25rem;
    }

    .footer__inner {
      gap: 0.35rem;
    }

    .footlinks {
      gap: 6px 16px;
      margin-top: 0.85rem;
    }

    .legal {
      gap: 2px 14px;
      margin-top: 0.65rem;
    }

    .legal a {
      font-size: 14px;
    }

    .copy {
      margin-top: 0.5rem;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .langs a,
    .legal a {
      transition: none;
    }
  }
</style>
