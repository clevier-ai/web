---
import { linkedinHref } from "../i18n/ui";

interface Props {
  label: string;
  text?: boolean;
}

const { label, text = false } = Astro.props;
---

<a
  class:list={["linkedin", { "is-text": text }]}
  href={linkedinHref}
  target="_blank"
  rel="noopener noreferrer"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
    <path
      fill="currentColor"
      d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.27V1.73C24 .77 23.2 0 22.23 0z"
    ></path>
  </svg>
  <span class:list={{ "sr-only": !text }}>{label}</span>
</a>

<style>
  .linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .linkedin.is-text {
    justify-content: flex-start;
    min-width: 0;
    width: fit-content;
    font: 500 16px/1.3 var(--clv-font-body);
  }

  .linkedin.is-text:hover {
    text-decoration: underline;
  }

  .linkedin:not(.is-text):hover {
    opacity: 0.72;
  }
</style>
