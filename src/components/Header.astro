---
import { copy, routes, type Lang, type PageId } from "../i18n/ui";

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
const t = copy[lang];
const to = (id: string) => (page === "home" ? `#${id}` : `${routes[lang].home}#${id}`);
const sections = [
  { href: to("como"), label: t.howTitle },
  { href: to("trabajo"), label: t.workTitle },
];
const contactHref = to("contacto");
---

<header class="header">
  <div class="wrap bar">
    <a class="brand" href={routes[lang].home} aria-label="Clevier">
      <img src="/brand/Clevier_Logo_Positiu_v1.svg" alt="" width="128" height="29" />
    </a>
    <details class="menu">
      <summary>
        <span class="menu__label">Menú</span>
        <span class="menu__close">{t.close}</span>
      </summary>
      <nav class="menu__panel" aria-label={lang === "ca" ? "Seccions" : "Secciones"}>
        {
          sections.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
    </details>
    <a class="btn header__cta" href={contactHref}>{t.write}</a>
  </div>
</header>

<script>
  const menu = document.querySelector(".menu");
  if (menu instanceof HTMLDetailsElement) {
    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    }
  }
</script>

<style>
  .header {
    position: sticky;
    top: 12px;
    z-index: 20;
    width: min(1120px, calc(100% - 24px));
    margin-inline: auto;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: var(--clv-radius);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.52), rgba(255, 255, 255, 0.22));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(22px) saturate(1.7);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
  }

  .header .wrap {
    width: auto;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding-inline: 16px;
  }

  .brand {
    display: grid;
    margin-right: auto;
  }

  .brand img {
    width: 108px;
    height: auto;
  }

  .header__cta {
    min-height: 44px;
    padding-inline: 0.95rem;
    font-size: 15px;
  }

  .menu {
    position: relative;
  }

  .menu summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 4px;
    font: 600 15px/1 var(--clv-font-display);
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu__close {
    display: none;
  }

  .menu[open] .menu__label {
    display: none;
  }

  .menu[open] .menu__close {
    display: inline;
  }

  .menu:not([open]) .menu__panel {
    display: none;
  }

  .menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 30;
    display: grid;
    min-width: 220px;
    max-width: calc(100vw - 40px);
    padding-block: 6px;
    background: linear-gradient(180deg, rgba(250, 250, 248, 0.97), rgba(250, 250, 248, 0.94));
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: var(--clv-radius);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    transform-origin: top right;
  }

  .menu[open] .menu__panel {
    animation: menu-in var(--dur-2) var(--ease-out);
  }

  .menu__panel a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 16px;
    font: 600 16px/1.2 var(--clv-font-display);
    text-decoration: none;
  }

  .menu__panel a:hover,
  .menu__panel a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 799px) {
    .header {
      top: 10px;
      width: min(1120px, calc(100% - 20px));
    }

    .bar {
      min-height: 58px;
      gap: 10px;
      padding-inline: 14px;
    }

    .brand img {
      width: 96px;
    }

    .header__cta {
      min-height: 40px;
      padding-inline: 0.85rem;
      font-size: 14px;
    }

    .menu summary {
      font-size: 14px;
    }
  }

  @media (min-width: 800px) {
    .bar {
      min-height: 72px;
    }

    .brand img {
      width: 128px;
    }

    .header__cta {
      min-height: 44px;
      padding-inline: 1.1rem;
      font-size: 16px;
    }

    .menu {
      display: block;
      flex: none;
      width: max-content;
    }

    .menu::details-content {
      display: block;
      content-visibility: visible;
    }

    .menu summary {
      display: none;
    }

    .menu__panel {
      position: static;
      display: flex !important;
      align-items: center;
      height: auto;
      width: max-content;
      min-width: max-content;
      max-width: none;
      padding: 0;
      border: 0;
      background: transparent;
      animation: none;
      gap: 2px;
    }

    .menu__panel a {
      padding-inline: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__panel {
      animation: none;
    }
  }
</style>
