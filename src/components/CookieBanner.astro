---
import { copy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const t = copy[Astro.props.lang].consent;
---

<div class="consent" data-consent hidden role="region" aria-label="Cookies">
  <p>{t.text}</p>
  <div class="consent__acciones">
    <button type="button" class="consent__btn" data-consent-choice="rejected">{t.reject}</button>
    <button type="button" class="consent__btn consent__btn--si" data-consent-choice="accepted">{t.accept}</button>
  </div>
</div>

<script>
  // La elección se guarda en localStorage (no es una cookie) y se anuncia con un evento,
  // para que una futura analítica solo arranque si el valor es "accepted".
  const KEY = "clv-consent";
  const banner = document.querySelector<HTMLElement>("[data-consent]");

  function read(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  if (banner) {
    if (!read()) banner.hidden = false;
    banner.querySelectorAll<HTMLButtonElement>("[data-consent-choice]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const choice = btn.dataset.consentChoice ?? "rejected";
        try {
          localStorage.setItem(KEY, choice);
        } catch {
          /* ignore */
        }
        banner.hidden = true;
        window.dispatchEvent(new CustomEvent("clv:consent", { detail: choice }));
      });
    });
  }
</script>

<style>
  .consent {
    position: fixed;
    z-index: 50;
    left: 50%;
    bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 1rem;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    border: 1px solid var(--clv-border);
    border-radius: var(--clv-radius-pill);
    background: var(--clv-surface);
    box-shadow: 0 8px 24px -12px rgba(26, 28, 30, 0.25);
    transform: translateX(-50%);
    animation: sube var(--dur-3) var(--ease-out) both;
    animation-delay: 400ms;
  }

  .consent[hidden] { display: none; }

  @keyframes sube {
    from { opacity: 0; transform: translate(-50%, 8px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  .consent p {
    color: var(--clv-text);
    font: var(--clv-text-small);
  }

  .consent__acciones {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .consent__btn {
    min-height: 40px;
    padding: 0 1rem;
    border: 0;
    border-radius: var(--clv-radius-pill);
    background: transparent;
    color: var(--clv-text-secondary);
    font: 600 14px/1 var(--clv-font-body);
    transition: color var(--dur-1) var(--ease-std), background-color var(--dur-1) var(--ease-std);
  }

  .consent__btn:hover { color: var(--clv-text); background: rgba(26, 28, 30, 0.06); }

  .consent__btn--si {
    background: linear-gradient(180deg, #34383c 0%, var(--clv-cta-bg) 100%);
    color: var(--clv-cta-text);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.35),
      0 6px 12px -6px rgba(26, 28, 30, 0.5);
  }

  .consent__btn--si:hover {
    background: linear-gradient(180deg, #3d4246 0%, #222528 100%);
    color: var(--clv-cta-text);
  }

  .consent__btn:focus-visible {
    outline: 2px solid var(--clv-text);
    outline-offset: 2px;
  }

  @media (max-width: 639px) {
    .consent {
      display: grid;
      gap: 0.85rem;
      width: calc(100% - 24px);
      max-width: none;
      bottom: 12px;
      padding: 1rem;
      border-radius: 20px;
    }

    .consent p {
      font-size: 15px;
      line-height: 1.45;
    }

    .consent__acciones {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }

    .consent__btn {
      min-height: 46px;
      font-size: 15px;
      border: 1px solid var(--clv-border);
    }

    .consent__btn--si {
      border-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent { animation: none; }
    .consent__btn { transition: none; }
  }
</style>
