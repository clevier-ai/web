---
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const mail = `mailto:hola@clevier.ai?subject=${encodeURIComponent(t.mailSubject)}&body=${encodeURIComponent(t.mailBody)}`;
---

<BaseLayout lang={lang} page="home" title={t.metaTitle} description={t.metaDescription}>
  <div class="page">
    <section class="cartel">
      <div class="wrap cartel__grid">
        <h1>
          <span>{t.claim[0]}</span>
          <span>{t.claim[1]}</span>
        </h1>
        <p class="lede">{t.lede}</p>
        <div class="acciones">
          <a class="btn" href="#contacto">{t.cta}</a>
          <a class="salto" href="#como">{t.howLabel}</a>
        </div>
      </div>
    </section>

    <section class="bloque" id="como" aria-labelledby="how-title">
      <div class="wrap">
        <h2 id="how-title">{t.howIntro}</h2>
        <ol class="filas">
          {
            t.steps.map((step, index) => (
              <li>
                <span class="num">{String(index + 1).padStart(2, "0")}</span>
                <details class="abre">
                  <summary>
                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.detail}</p>
                    </div>
                    <span class="abre__mas" aria-hidden="true">
                      <span class="abre__icon"></span>
                    </span>
                  </summary>
                  <div class="abre__cuerpo">
                    <p>{step.extra}</p>
                  </div>
                </details>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bloque" id="trabajo" aria-labelledby="work-title">
      <div class="wrap">
        <h2 id="work-title">{t.workTitle}</h2>
        <p class="intro">{t.workLine}</p>
        <ul class="filas filas--resto">
          {
            t.services.map((service) => (
              <li id={service.id}>
                <details class="abre">
                  <summary>
                    <div>
                      <h3>{service.name}</h3>
                      <p>{service.more}</p>
                    </div>
                    <p class="meta">{service.meta}</p>
                    <span class="abre__mas" aria-hidden="true">
                      <span class="abre__icon"></span>
                    </span>
                  </summary>
                  <div class="abre__cuerpo">
                    <p>{service.detail}</p>
                    <p>{service.extra}</p>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bloque cierre" id="contacto" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 id="contact-title">
          <a class="mail enlace" href={mail}>hola@clevier.ai</a>
        </h2>
        <p class="cierre__linea">{t.contactAfter}</p>
        <p class="cierre__linea">{t.contactNeed}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Dirección — inicio de Clevier
     Para quién: quien dirige una pyme y compara a quién encargar la IA
     Sensación: un despacho con luz de mañana, frases que se entienden a la primera
     Idea: cartel de oferta — dos líneas que dicen qué, cuándo y a qué precio
     Tipo: Sora 700 a unas 4× Figtree 18px, interletraje −0.02em
     Color: papel #FAFAF8, tinta #1F2328; lima #C8F169 solo en el texto del botón
     Detalle: el ejemplo (parte, pedido, factura) va en la frase de debajo
     Rechazos: eslogan que hay que descifrar, titular a tamaño de valla, desierto entre secciones */

  .cartel__grid {
    display: grid;
    min-width: 0;
    row-gap: 1.15rem;
    align-items: start;
    padding-block: clamp(2.75rem, 6vw, 4.25rem) clamp(1.25rem, 3vw, 2rem);
  }

  h1 {
    min-width: 0;
    font: 700 clamp(2.05rem, 1rem + 4.2vw, 5rem) / 1.02 var(--clv-font-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    animation: llega var(--dur-3) var(--ease-out) both;
  }

  h1 span + span { animation-delay: 60ms; }

  @keyframes llega {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  .lede {
    max-width: 38rem;
    color: var(--clv-text);
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
  }

  .salto {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 1.0625rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .bloque { padding-block: clamp(3rem, 5.5vw, 4.75rem); }

  .bloque h2 {
    max-width: 22em;
    font: var(--clv-text-h2);
    letter-spacing: -0.02em;
  }

  .filas {
    list-style: none;
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .filas li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    align-items: start;
    padding: 1.15rem 1.45rem;
    border-top: 1px solid var(--clv-border);
  }

  .filas li:last-child { border-bottom: 1px solid var(--clv-border); }

  .num, .meta {
    color: var(--clv-text-secondary);
    font: var(--clv-text-label);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .num { padding-top: 0.4rem; }

  .filas h3 {
    font: var(--clv-text-h3);
    letter-spacing: -0.02em;
  }

  .filas--resto li { grid-template-columns: minmax(0, 1fr); }

  .abre { min-width: 0; }

  .abre summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
  }

  .filas--resto .abre summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "texto mas"
      "meta mas";
    column-gap: 1rem;
    row-gap: 0.35rem;
    align-items: start;
  }

  .filas--resto .abre summary > div { grid-area: texto; min-width: 0; }

  .filas--resto .abre summary .meta {
    grid-area: meta;
    grid-column: auto;
    margin-top: 0;
    text-align: left;
  }

  .filas--resto .abre summary .abre__mas { grid-area: mas; }

  .abre summary::-webkit-details-marker { display: none; }

  .abre summary::marker { content: ""; }

  .abre__mas {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-top: -0.35rem;
    color: var(--clv-text-secondary);
  }

  .abre__icon {
    position: relative;
    display: block;
    width: 13px;
    height: 13px;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .abre__icon::before,
  .abre__icon::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    background: currentColor;
    border-radius: 1px;
  }

  .abre__icon::before {
    width: 100%;
    height: 1.5px;
    transform: translate(-50%, -50%);
  }

  .abre__icon::after {
    width: 1.5px;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  .abre[open] .abre__icon {
    transform: rotate(45deg);
  }

  .abre summary:hover .abre__mas,
  .abre summary:focus-visible .abre__mas {
    color: var(--clv-text);
  }

  .abre__cuerpo {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--clv-border);
  }

  .abre__cuerpo p + p { margin-top: 0.55rem; }

  .filas p { max-width: 62ch; margin-top: 0.4rem; }
  .filas p + p { margin-top: 0.35rem; }

  .meta { grid-column: 2; margin-top: 0.55rem; }

  .intro { max-width: 62ch; margin-top: 0.85rem; }

  .cierre__linea {
    max-width: 42rem;
    margin-top: 1rem;
  }

  .cierre__linea + .cierre__linea { margin-top: 0.4rem; }

  .cierre h2 { max-width: none; }

  .mail {
    font: 700 clamp(2rem, 1rem + 3vw, 3.5rem) / 1.05 var(--clv-font-display);
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.08em;
    overflow-wrap: anywhere;
  }

  #como, #trabajo, #contacto { scroll-margin-top: 5.5rem; }

  .filas li:not(:has(.meta)) {
    grid-template-columns: 2.75rem minmax(0, 1fr);
  }

  /* Móvil: más aire, tipografía un poco más pequeña, menos apretado.
     Escritorio (≥800px) se queda como está. */
  @media (max-width: 799px) {
    .cartel__grid {
      row-gap: 1.4rem;
      padding-block: 2.25rem 2.75rem;
    }

    h1 {
      font-size: clamp(1.85rem, 1.15rem + 3.2vw, 2.35rem);
      line-height: 1.08;
    }

    .lede {
      font-size: 1.05rem;
      line-height: 1.55;
      max-width: 28rem;
    }

    .acciones {
      gap: 10px 18px;
      margin-top: 0.25rem;
    }

    .salto {
      font-size: 1rem;
    }

    .bloque {
      padding-block: 3.75rem;
    }

    .bloque h2 {
      font-size: clamp(1.55rem, 1.2rem + 1.8vw, 1.85rem);
      line-height: 1.15;
    }

    .intro {
      margin-top: 1rem;
      font-size: 1.05rem;
      line-height: 1.55;
    }

    .filas {
      margin-top: 2rem;
    }

    .filas li {
      grid-template-columns: 2.35rem minmax(0, 1fr);
      column-gap: 0.85rem;
      padding: 1.45rem 0;
    }

    .filas li:not(:has(.meta)) {
      grid-template-columns: 2.35rem minmax(0, 1fr);
    }

    .filas--resto li {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 1.55rem;
    }

    .num {
      padding-top: 0.3rem;
      font-size: 11px;
    }

    .filas h3 {
      font-size: 1.2rem;
      line-height: 1.25;
    }

    .filas p {
      margin-top: 0.5rem;
      font-size: 1rem;
      line-height: 1.55;
    }

    .filas--resto .abre summary {
      column-gap: 0.65rem;
      row-gap: 0.5rem;
    }

    .filas--resto .abre summary .meta {
      font-size: 11px;
      letter-spacing: 0.05em;
    }

    .abre__mas {
      width: 40px;
      height: 40px;
      margin-top: -0.2rem;
    }

    .abre__cuerpo {
      margin-top: 1rem;
      padding-top: 1rem;
    }

    .abre__cuerpo p + p {
      margin-top: 0.7rem;
    }

    .cierre__linea {
      margin-top: 1.15rem;
      font-size: 1.05rem;
      line-height: 1.55;
    }

    .cierre__linea + .cierre__linea {
      margin-top: 0.65rem;
    }

    .mail {
      font-size: clamp(1.65rem, 1rem + 3.5vw, 2.15rem);
      line-height: 1.12;
    }

    #como,
    #trabajo,
    #contacto {
      scroll-margin-top: 5rem;
    }
  }

  @media (min-width: 800px) {
    .filas li {
      grid-template-columns: 3rem minmax(0, 1fr) 12rem;
      column-gap: 1.5rem;
    }
    .filas li:not(:has(.meta)) {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .meta {
      grid-column: auto;
      margin-top: 0;
      padding-top: 0.45rem;
      text-align: right;
    }

    .filas--resto li {
      grid-template-columns: minmax(0, 1fr);
    }

    .filas--resto .abre summary {
      grid-template-columns: minmax(0, 1fr) 12rem auto;
      grid-template-areas: "texto meta mas";
      column-gap: 1.5rem;
    }

    .filas--resto .abre summary .meta {
      padding-top: 0.45rem;
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .abre__icon {
      transition: none;
    }

    h1 span {
      animation: none;
    }
  }

</style>

<script>
  document.querySelectorAll("details.abre").forEach((el) => {
    el.addEventListener("toggle", () => {
      if (!(el instanceof HTMLDetailsElement) || !el.open) return;
      document.querySelectorAll("details.abre[open]").forEach((other) => {
        if (other !== el && other instanceof HTMLDetailsElement) {
          other.open = false;
        }
      });
    });
  });
</script>
