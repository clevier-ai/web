---
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy, type Lang } from "../i18n/ui";
import logoPrimerCanal from "../assets/clients/primercanal.png";
import logoMetalografica from "../assets/clients/metalografica.png";
import logoCocoHomes from "../assets/clients/coco-homes.png";
import logoDelgo from "../assets/clients/delgo.png";
import logoAql from "../assets/clients/aql.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const mail = `mailto:hola@clevier.ai?subject=${encodeURIComponent(t.mailSubject)}&body=${encodeURIComponent(t.mailBody)}`;

const clients = [
  { name: "Primer Canal", href: "https://primercanal.com/", logo: logoPrimerCanal },
  { name: "Metalográfica", href: "https://metalografica.com/", logo: logoMetalografica },
  { name: "Coco Homes", href: "https://www.coco-homes.es/", logo: logoCocoHomes },
  { name: "Delgo", href: "https://delgo.es/", logo: logoDelgo },
  { name: "AQL Protección", href: "https://www.aqlproteccion.com/", logo: logoAql },
];
---

<BaseLayout lang={lang} page="home" title={t.metaTitle} description={t.metaDescription}>
  <div class="page">
    <section class="cartel">
      <div class="wrap cartel__grid">
        <h1>
          <span>{t.claim[0]}</span>
          <span>{t.claim[1]}</span>
        </h1>
        <p class="lede">{t.lede}</p>
        <p class="hecho">{t.proof}</p>
        <div class="acciones">
          <a class="btn" href="#contacto">{t.cta}</a>
          <a class="salto" href="#como">{t.howLabel}</a>
        </div>
      </div>
    </section>

    <section class="bloque" id="como" aria-labelledby="how-title">
      <div class="wrap">
        <h2 id="how-title">{t.howIntro}</h2>
        <ol class="filas">
          {
            t.steps.map((step, index) => (
              <li>
                <span class="num">{String(index + 1).padStart(2, "0")}</span>
                <details class="abre">
                  <summary>
                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.detail}</p>
                    </div>
                    <span class="abre__mas" aria-hidden="true">
                      <span class="abre__icon"></span>
                    </span>
                  </summary>
                  <div class="abre__cuerpo">
                    <p>{step.extra}</p>
                  </div>
                </details>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bloque" id="trabajo" aria-labelledby="work-title">
      <div class="wrap">
        <h2 id="work-title">{t.workTitle}</h2>
        <p class="intro">{t.workLine}</p>
        <ul class="filas filas--resto">
          {
            t.services.map((service) => (
              <li id={service.id}>
                <div>
                  <h3>{service.name}</h3>
                  <p>{service.more}</p>
                </div>
                <p class="meta">{service.meta}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bloque clientes" id="clientes" aria-labelledby="clients-title">
      <div class="wrap">
        <h2 id="clients-title">{t.clientsTitle}</h2>
        <ul class="clientes__list">
          {
            clients.map((client) => (
              <li>
                <a href={client.href} target="_blank" rel="noopener noreferrer">
                  <img
                    src={client.logo.src}
                    alt={client.name}
                    width={client.logo.width}
                    height={client.logo.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bloque cierre" id="contacto" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 id="contact-title">
          <a class="mail enlace" href={mail}>hola@clevier.ai</a>
        </h2>
        <p class="cierre__linea">{t.contactAfter}</p>
        <p class="cierre__linea">{t.contactNeed}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Dirección — inicio de Clevier
     Para quién: quien dirige una pyme y compara a quién encargar la IA
     Sensación: un despacho con luz de mañana, frases que se entienden a la primera
     Idea: cartel de oferta, y debajo un encargo con nombre
     Tipo: Sora 700 a unas 4× Figtree 18px, interletraje −0.02em
     Color: papel #FAFAF8, tinta #1F2328; lima #C8F169 solo en el texto del botón
     Detalle: Primer Canal nombra el trabajo; el resto de la página no lo repite
     Rechazos: lista numerada por duplicado, cifra de mercado, correo sin qué pasa después */

  .cartel__grid {
    display: grid;
    min-width: 0;
    row-gap: 1.15rem;
    align-items: start;
    padding-block: clamp(2.75rem, 6vw, 4.25rem) clamp(1.25rem, 3vw, 2rem);
  }

  h1 {
    min-width: 0;
    font: 700 clamp(2.05rem, 1rem + 4.2vw, 5rem) / 1.02 var(--clv-font-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    animation: llega var(--dur-3) var(--ease-out) both;
  }

  h1 span + span { animation-delay: 60ms; }

  @keyframes llega {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  .lede,
  .hecho {
    max-width: 38rem;
    color: var(--clv-text);
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .hecho { font-weight: 600; }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
  }

  .salto {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 1.0625rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .bloque { padding-block: clamp(3rem, 5.5vw, 4.75rem); }

  .clientes {
    padding-block: clamp(3rem, 5.5vw, 4.75rem);
  }

  .bloque h2 {
    max-width: 22em;
    font: var(--clv-text-h2);
    letter-spacing: -0.02em;
  }

  .clientes h2 {
    max-width: 16em;
  }

  .clientes__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.35rem 2.5rem;
    list-style: none;
    margin-top: 1.75rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: var(--clv-radius);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.78));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
  }

  .clientes__list a {
    display: grid;
    place-items: center;
    min-height: 44px;
    min-width: 44px;
  }

  .clientes__list img {
    display: block;
    width: auto;
    height: 2.35rem;
    max-width: 10.5rem;
    object-fit: contain;
  }

  .clientes__list li:nth-child(2) img {
    height: 3.15rem;
    max-width: 4rem;
  }

  .filas {
    list-style: none;
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .filas li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    align-items: start;
    padding: 1.15rem 1.45rem;
    border-top: 1px solid var(--clv-border);
  }

  .filas li:last-child { border-bottom: 1px solid var(--clv-border); }

  .num, .meta {
    color: var(--clv-text-secondary);
    font: var(--clv-text-label);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .num { padding-top: 0.4rem; }

  .filas h3 {
    font: var(--clv-text-h3);
    letter-spacing: -0.02em;
  }

  .filas--resto li { grid-template-columns: minmax(0, 1fr); }

  .filas--resto .meta { grid-column: 1; }

  .abre { min-width: 0; }

  .abre summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
  }

  .abre summary::-webkit-details-marker { display: none; }

  .abre summary::marker { content: ""; }

  .abre__mas {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-top: -0.35rem;
    color: var(--clv-text-secondary);
  }

  .abre__icon {
    position: relative;
    display: block;
    width: 13px;
    height: 13px;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .abre__icon::before,
  .abre__icon::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    background: currentColor;
    border-radius: 1px;
  }

  .abre__icon::before {
    width: 100%;
    height: 1.5px;
    transform: translate(-50%, -50%);
  }

  .abre__icon::after {
    width: 1.5px;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  .abre[open] .abre__icon {
    transform: rotate(45deg);
  }

  .abre summary:hover .abre__mas,
  .abre summary:focus-visible .abre__mas {
    color: var(--clv-text);
  }

  .abre__cuerpo {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--clv-border);
  }

  .abre__cuerpo p + p { margin-top: 0.55rem; }

  .filas p { max-width: 62ch; margin-top: 0.4rem; }
  .filas p + p { margin-top: 0.35rem; }

  .meta { grid-column: 2; margin-top: 0.55rem; }

  .intro { max-width: 62ch; margin-top: 0.85rem; }

  .cierre__linea {
    max-width: 42rem;
    margin-top: 1rem;
  }

  .cierre__linea + .cierre__linea { margin-top: 0.4rem; }

  .cierre h2 { max-width: none; }

  .mail {
    font: 700 clamp(2rem, 1rem + 3vw, 3.5rem) / 1.05 var(--clv-font-display);
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.08em;
    overflow-wrap: anywhere;
  }

  #clientes, #como, #trabajo, #contacto { scroll-margin-top: 5.5rem; }

  .filas li:not(:has(.meta)) {
    grid-template-columns: 2.75rem minmax(0, 1fr);
  }

  @media (min-width: 800px) {
    .filas li {
      grid-template-columns: 3rem minmax(0, 1fr) 12rem;
      column-gap: 1.5rem;
    }
    .filas li:not(:has(.meta)) {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .meta {
      grid-column: auto;
      margin-top: 0;
      padding-top: 0.45rem;
      text-align: right;
    }

    .filas--resto li {
      grid-template-columns: minmax(0, 1fr) 12rem;
    }

    .filas--resto .meta { grid-column: auto; }

    .clientes__list {
      gap: 1.5rem 3rem;
      padding: 1.35rem 1.6rem;
    }

    .clientes__list img {
      height: 2.65rem;
      max-width: 11rem;
    }

    .clientes__list li:nth-child(2) img {
      height: 3.5rem;
      max-width: 4.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clientes__list a,
    .abre__icon {
      transition: none;
    }

    h1 span {
      animation: none;
    }
  }

</style>
