---
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy, surveyHref, type Lang } from "../i18n/ui";
import logoPrimerCanal from "../assets/clients/primercanal.png";
import logoMetalografica from "../assets/clients/metalografica.png";
import logoCocoHomes from "../assets/clients/coco-homes.png";
import logoDelgo from "../assets/clients/delgo.png";
import logoAql from "../assets/clients/aql.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const mail = `mailto:hola@clevier.ai?subject=${encodeURIComponent(t.mailSubject)}&body=${encodeURIComponent(t.mailBody)}`;
const cut = t.lede.indexOf(". ");
const ledeMain = cut === -1 ? t.lede : t.lede.slice(0, cut + 1);
const ledeMargin = cut === -1 ? "" : t.lede.slice(cut + 2);

const clients = [
  { name: "Primer Canal", href: "https://primercanal.com/", logo: logoPrimerCanal },
  { name: "Metalográfica", href: "https://metalografica.com/", logo: logoMetalografica },
  { name: "Coco Homes", href: "https://www.coco-homes.es/", logo: logoCocoHomes },
  { name: "Delgo", href: "https://delgo.es/", logo: logoDelgo },
  { name: "AQL Protección", href: "https://www.aqlproteccion.com/", logo: logoAql },
];
---

<BaseLayout lang={lang} page="home" title={t.metaTitle} description={t.metaDescription}>
  <div class="page">
    <section class="cartel">
      <div class="wrap cartel__grid">
        {ledeMargin && <p class="margen">{ledeMargin}</p>}
        <h1>
          <span>{t.claim[0]}</span>
          <span class="marca">{t.claim[1]}</span>
        </h1>
        <p class="lede">{ledeMain}</p>
        <div class="acciones">
          <a class="btn" href="#contacto">{t.cta}</a>
          <a class="salto" href="#como">{t.howLabel}</a>
        </div>
      </div>
    </section>

    <section class="bloque" id="como" aria-labelledby="how-title">
      <div class="wrap">
        <h2 id="how-title">{t.howIntro}</h2>
        <ol class="filas">
          {
            t.steps.map((step, index) => (
              <li>
                <span class="num">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bloque" id="trabajo" aria-labelledby="work-title">
      <div class="wrap">
        <h2 id="work-title">{t.workLine}</h2>
        <ol class="filas filas--trabajo">
          {
            t.services.map((service, index) => (
              <li id={service.id} class={index === 0 ? "is-activa" : undefined}>
                <span class="num">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{service.name}</h3>
                  <p>{service.more}</p>
                  <p>{service.detail}</p>
                </div>
                <p class="meta">{service.meta}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bloque" aria-labelledby="prepare-title">
      <div class="wrap">
        <h2 id="prepare-title">{t.prepareTitle}</h2>
        <p class="intro">{t.prepareIntro}</p>
        <ul class="listo">
          {
            t.prepare.map((item) => (
              <li>
                <span>{item.k}</span>
                {item.v}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bloque" aria-labelledby="dato">
      <div class="wrap">
        <h2 id="dato" class="sr-only">{t.surveyLabel}</h2>
        <p class="prueba">
          {
            t.survey.split(/(\d[\d\s.,]*\s?%)/g).map((part) =>
              /^\d/.test(part) ? <strong class="cifra">{part}</strong> : part,
            )
          }
        </p>
        <p class="fuente">
          <a class="enlace" href={surveyHref} target="_blank" rel="noopener noreferrer">{t.surveySource}</a>
        </p>
      </div>
    </section>

    <section class="bloque clientes" id="clientes" aria-labelledby="clients-title">
      <div class="wrap">
        <h2 id="clients-title">{t.clientsTitle}</h2>
        <ul class="clientes__list">
          {
            clients.map((client) => (
              <li>
                <a href={client.href} target="_blank" rel="noopener noreferrer">
                  <img
                    src={client.logo.src}
                    alt={client.name}
                    width={client.logo.width}
                    height={client.logo.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bloque cierre" id="contacto" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 id="contact-title">
          <a class="mail enlace" href={mail}>hola@clevier.ai</a>
        </h2>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  let stopTrabajo = () => {};

  function bindTrabajo() {
    stopTrabajo();
    const list = document.querySelector(".filas--trabajo");
    if (!(list instanceof HTMLOListElement)) {
      stopTrabajo = () => {};
      return;
    }

    const items = [...list.querySelectorAll(":scope > li")];
    if (!items.length) return;

    const setActive = (index) => {
      items.forEach((item, i) => item.classList.toggle("is-activa", i === index));
    };

    let frame = 0;
    const update = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (!list.isConnected) return;
        const line = Math.max(128, window.innerHeight * 0.36);
        const bounds = list.getBoundingClientRect();
        if (bounds.bottom < line) {
          setActive(items.length - 1);
          return;
        }
        let current = 0;
        for (let i = 0; i < items.length; i++) {
          if (items[i].getBoundingClientRect().top <= line) current = i;
        }
        setActive(current);
      });
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    stopTrabajo = () => {
      if (frame) cancelAnimationFrame(frame);
      window.removeEventListener("scroll", update);
      window.removeEventListener("resize", update);
    };
  }

  bindTrabajo();
  document.addEventListener("astro:page-load", bindTrabajo);
</script>

<style>
  /* Dirección — inicio de Clevier
     Para quién: quien dirige una pyme y abre la web un martes, comparando a quién encargar la IA
     Sensación: papel al mediodía, con luz de lima cogida en el cristal
     Idea: cartel subrayado; el cristal líquido es la barra, la fila activa y la placa de logos
     Tipo: Sora 700 a unas 4,5× Figtree 18px
     Color: papel #FAFAF8, tinta #1F2328; lima #C8F169 en la segunda línea y en el texto del botón
     Detalle: «El precio se cierra antes» en el margen, a la altura de la primera línea
     Rechazos: noche en toda la página, malla violeta, hero a 100vh con el texto en el centro */

  .cartel__grid {
    display: grid;
    min-width: 0;
    grid-template-columns: 8.75rem minmax(0, 1fr);
    column-gap: 1.5rem;
    row-gap: 1.2rem;
    align-items: start;
    padding-block: clamp(3.25rem, 8vw, 6.5rem) clamp(2rem, 4vw, 3rem);
  }

  .cartel__grid:not(:has(.margen)) {
    grid-template-columns: minmax(0, 1fr);
  }

  .margen {
    grid-column: 1;
    grid-row: 1;
    max-width: 18ch;
    padding-top: 0.85rem;
    color: var(--clv-text-secondary);
    font: 400 15px/1.4 var(--clv-font-mono);
  }

  h1 {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    font: var(--clv-text-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    width: fit-content;
    max-width: 100%;
    animation: llega var(--dur-3) var(--ease-out) both;
  }

  h1 span + span { animation-delay: 60ms; }

  h1 .marca {
    margin-top: 0.14em;
    padding: 0.02em 0.16em 0.08em;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 46%),
      var(--clv-llima);
    color: var(--clv-grafit);
    border-radius: var(--clv-radius);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
  }

  @keyframes llega {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  .lede {
    grid-column: 2;
    grid-row: 2;
    max-width: 36ch;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .acciones {
    grid-column: 2;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
  }

  .salto {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 1.0625rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .bloque { padding-block: clamp(4.5rem, 9vw, 8.5rem); }

  .clientes {
    padding-block: clamp(4.5rem, 9vw, 8.5rem);
  }

  .bloque h2 {
    max-width: 16em;
    font: var(--clv-text-h2);
    letter-spacing: -0.03em;
  }

  .clientes h2 {
    max-width: 16em;
  }

  .clientes__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.35rem 2.5rem;
    list-style: none;
    margin-top: 1.75rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: var(--clv-radius);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.38));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
  }

  .clientes__list a {
    display: grid;
    place-items: center;
    min-height: 44px;
    min-width: 44px;
  }

  .clientes__list img {
    display: block;
    width: auto;
    height: 1.7rem;
    max-width: 8.75rem;
    object-fit: contain;
  }

  .clientes__list li:nth-child(2) img {
    height: 2.65rem;
    max-width: 3.4rem;
  }

  .filas {
    list-style: none;
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .filas li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    align-items: start;
    padding-block: 1.2rem 1.35rem;
    border-top: 1px solid var(--clv-border);
  }

  .filas li:last-child { border-bottom: 1px solid var(--clv-border); }

  .num, .meta {
    color: var(--clv-text-secondary);
    font: var(--clv-text-label);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .num { padding-top: 0.4rem; }

  .filas h3 {
    font: var(--clv-text-h3);
    letter-spacing: -0.02em;
  }

  .filas--trabajo li {
    position: relative;
    z-index: 0;
  }

  .filas--trabajo li::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0.2rem 0;
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: var(--clv-radius);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.4));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px) saturate(1.55);
    -webkit-backdrop-filter: blur(16px) saturate(1.55);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
    pointer-events: none;
  }

  .filas--trabajo li.is-activa::before {
    opacity: 1;
  }

  .filas--trabajo .num {
    transition: color var(--dur-1) var(--ease-std);
  }

  .filas--trabajo li.is-activa .num {
    color: var(--clv-text);
  }

  .filas p { max-width: 62ch; margin-top: 0.4rem; }
  .filas p + p { margin-top: 0.35rem; }

  .meta { grid-column: 2; margin-top: 0.55rem; }

  .intro { max-width: 62ch; margin-top: 0.85rem; }

  .listo {
    list-style: none;
    max-width: 62ch;
    margin-top: 1.5rem;
  }

  .listo li {
    padding-block: 0.9rem;
    border-top: 1px solid var(--clv-border);
  }

  .listo li:last-child { border-bottom: 1px solid var(--clv-border); }

  .listo span {
    display: block;
    margin-bottom: 0.2rem;
    font: 600 1.05rem/1.3 var(--clv-font-display);
  }

  .prueba {
    max-width: 40rem;
    padding: 1.2rem 1.35rem 1.25rem 1.15rem;
    border-left: 2px solid var(--clv-text);
    border-radius: 0 var(--clv-radius) var(--clv-radius) 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.36));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .cifra { font-weight: 600; font-variant-numeric: tabular-nums; }

  .fuente {
    max-width: 40rem;
    margin-top: 0.9rem;
    padding-left: 1.1rem;
    font: var(--clv-text-small);
  }

  .cierre h2 { max-width: none; }

  .mail {
    font: 700 clamp(2rem, 1rem + 3vw, 3.5rem) / 1.05 var(--clv-font-display);
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.08em;
    overflow-wrap: anywhere;
  }

  #clientes, #como, #trabajo, #contacto { scroll-margin-top: 5.5rem; }

  .filas li:not(:has(.meta)) {
    grid-template-columns: 2.75rem minmax(0, 1fr);
  }

  @media (min-width: 800px) {
    .filas li {
      grid-template-columns: 3rem minmax(0, 1fr) 10.5rem;
      column-gap: 1.5rem;
    }
    .filas li:not(:has(.meta)) {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .meta {
      grid-column: auto;
      margin-top: 0;
      padding-top: 0.45rem;
      text-align: right;
    }

    .clientes__list {
      gap: 1.5rem 3rem;
      padding: 1.35rem 1.6rem;
    }

    .clientes__list img {
      height: 1.9rem;
      max-width: 9.5rem;
    }

    .clientes__list li:nth-child(2) img {
      height: 3rem;
      max-width: 3.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clientes__list a,
    .filas--trabajo li::before,
    .filas--trabajo li.is-activa .num {
      transition: none;
    }

    h1 span {
      animation: none;
    }
  }

  @media (max-width: 839px) {
    .cartel__grid { grid-template-columns: 1fr; }
    .margen, h1, .lede, .acciones,
    .cartel__grid:not(:has(.margen)) > * { grid-column: 1; }
    h1 { grid-row: 1; }
    .lede { grid-row: 2; }
    .margen { grid-row: 3; max-width: 36ch; padding-top: 0; }
    .acciones { grid-row: 4; }
  }
</style>
