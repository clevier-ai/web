---
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const mail = `mailto:hola@clevier.ai?subject=${encodeURIComponent(t.mailSubject)}&body=${encodeURIComponent(t.mailBody)}`;
---

<BaseLayout lang={lang} page="home" title={t.metaTitle} description={t.metaDescription}>
  <div class="page">
    <section class="cartel">
      <div class="wrap cartel__grid">
        <h1>
          <span>{t.claim[0]}</span>
          <span class="claim-line">{t.claim[1]}</span>
        </h1>
        <p class="lede">{t.lede}</p>
        <div class="acciones">
          <a class="btn" href="#contacto">{t.cta}</a>
          <a class="salto" href="#como">{t.howLabel}</a>
        </div>
      </div>
    </section>

    <section class="bloque" id="como" aria-labelledby="how-title">
      <div class="wrap">
        <h2 id="how-title">{t.howIntro}</h2>
        <ol class="filas">
          {
            t.steps.map((step, index) => (
              <li class="paso">
                <span class="num">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p class="paso__detail">{step.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bloque" id="trabajo" aria-labelledby="work-title">
      <div class="wrap">
        <h2 id="work-title">{t.workTitle}</h2>
        <p class="intro">{t.workLine}</p>
        <ul class="filas filas--resto">
          {
            t.services.map((service) => (
              <li id={service.id}>
                <details class="abre">
                  <summary>
                    <div>
                      <h3>{service.name}</h3>
                      <p>{service.more}</p>
                    </div>
                    <p class="meta">{service.meta}</p>
                    <span class="abre__mas" aria-hidden="true">
                      <span class="abre__icon"></span>
                    </span>
                  </summary>
                  <div class="abre__cuerpo">
                    <p>{service.detail}</p>
                    <p>{service.extra}</p>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bloque cierre" id="contacto" aria-labelledby="contact-title">
      <div class="wrap cierre__grid">
        <div class="cierre__texto">
          <p class="cierre__etiqueta">{t.contactTitle}</p>
          <h2 id="contact-title">{t.contactAfter}</h2>
          <p class="cierre__linea">{t.contactNeed}</p>
        </div>

        <form class="form" method="post" action="/api/contact" data-form data-sending={t.form.sending} data-ok={t.form.ok} data-error={t.form.error}>
          <label>
            <span>{t.form.name}</span>
            <input name="name" type="text" autocomplete="name" required maxlength="120" />
          </label>
          <label>
            <span>{t.form.email}</span>
            <input name="email" type="email" autocomplete="email" required maxlength="200" />
          </label>
          <label>
            <span>{t.form.company}</span>
            <input name="company" type="text" autocomplete="organization" maxlength="160" />
          </label>
          <label>
            <span>{t.form.message}</span>
            <textarea name="message" rows="5" required maxlength="5000"></textarea>
          </label>
          <input class="form__trap" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="lang" value={lang} />
          <div class="form__foot">
            <button class="btn" type="submit">{t.form.send}</button>
            <p class="form__status" role="status" aria-live="polite"></p>
          </div>
        </form>

        <p class="cierre__mail">
          <span>{t.form.or}</span>
          <a class="mail enlace" href={mail}>hola@clevier.ai</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Dirección — inicio de Clevier (final)
     Para quién: quien dirige una pyme y compara a quién encargar la IA
     Sensación: papel seco con glow lima/verd vivo (como banner LinkedIn); liquid glass; CTA marfil
     Idea: cartel de oferta — dos líneas + lockup CL+evier; pasos siempre abiertos
     Tipo: Fraunces 700 ~4× Figtree 18px; lockup 67° gap −0.09em
     Color: papel #F7F6F2, tinta #1A1C1E; marfil en CTA; lima/verd solo en el glow
     Detalle: el monograma es la CL; Fraunces solo escribe “evier”
     Rechazos: fosforito en UI, labs de prueba, 2ª línea tintada */

  .cartel__grid {
    display: grid;
    min-width: 0;
    row-gap: 1.25rem;
    align-items: start;
    padding-block: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 3.5vw, 2.5rem);
  }

  h1 {
    min-width: 0;
    font: 700 clamp(2.15rem, 0.85rem + 4.6vw, 5.25rem) / 0.98 var(--clv-font-display);
    font-variation-settings: var(--clv-display-vars);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    animation: llega var(--dur-3) var(--ease-out) both;
  }

  h1 span + span { animation-delay: 70ms; }

  .claim-line {
    color: var(--clv-text);
  }

  @keyframes llega {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  .lede {
    max-width: 38rem;
    color: var(--clv-text);
    font-size: 1.125rem;
    line-height: 1.5;
    animation: llega var(--dur-3) var(--ease-out) both;
    animation-delay: 120ms;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    animation: llega var(--dur-3) var(--ease-out) both;
    animation-delay: 180ms;
  }

  .salto {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 1.0625rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .bloque { padding-block: clamp(3.25rem, 6vw, 5.25rem); }

  .bloque h2 {
    max-width: 22em;
    font: var(--clv-text-h2);
    font-variation-settings: var(--clv-heading-vars);
    letter-spacing: -0.025em;
  }

  .filas {
    list-style: none;
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .filas li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    align-items: start;
    padding: 1.15rem 1.45rem;
    border-top: 1px solid var(--clv-border);
  }

  .filas li:last-child { border-bottom: 1px solid var(--clv-border); }

  .num, .meta {
    color: var(--clv-text-secondary);
    font: var(--clv-text-label);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .num { padding-top: 0.4rem; }

  .filas h3 {
    font: var(--clv-text-h3);
    font-variation-settings: var(--clv-heading-vars);
    letter-spacing: -0.02em;
  }

  .paso__detail {
    color: var(--clv-text-secondary);
  }

  .filas--resto li { grid-template-columns: minmax(0, 1fr); }

  .abre { min-width: 0; }

  .abre summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
  }

  .filas--resto .abre summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "texto mas"
      "meta mas";
    column-gap: 1rem;
    row-gap: 0.35rem;
    align-items: start;
  }

  .filas--resto .abre summary > div { grid-area: texto; min-width: 0; }

  .filas--resto .abre summary .meta {
    grid-area: meta;
    grid-column: auto;
    margin-top: 0;
    text-align: left;
  }

  .filas--resto .abre summary .abre__mas { grid-area: mas; }

  .abre summary::-webkit-details-marker { display: none; }

  .abre summary::marker { content: ""; }

  .abre__mas {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-top: -0.35rem;
    color: var(--clv-text-secondary);
  }

  .abre__icon {
    position: relative;
    display: block;
    width: 13px;
    height: 13px;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .abre__icon::before,
  .abre__icon::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    background: currentColor;
    border-radius: 1px;
  }

  .abre__icon::before {
    width: 100%;
    height: 1.5px;
    transform: translate(-50%, -50%);
  }

  .abre__icon::after {
    width: 1.5px;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  .abre[open] .abre__icon {
    transform: rotate(45deg);
  }

  .abre summary:hover .abre__mas,
  .abre summary:focus-visible .abre__mas {
    color: var(--clv-text);
  }

  .abre__cuerpo {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--clv-border);
  }

  .abre__cuerpo p + p { margin-top: 0.55rem; }

  .filas p { max-width: 62ch; margin-top: 0.4rem; }
  .filas p + p { margin-top: 0.35rem; }

  .meta { grid-column: 2; margin-top: 0.55rem; }

  .intro { max-width: 62ch; margin-top: 0.85rem; }

  .cierre__grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .cierre__etiqueta {
    margin-bottom: 0.85rem;
    color: var(--clv-text-secondary);
    font: var(--clv-text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cierre h2 { max-width: 16em; }

  .cierre__linea {
    max-width: 34rem;
    margin-top: 1.1rem;
    color: var(--clv-text-secondary);
  }

  .cierre__mail {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .cierre__mail span {
    color: var(--clv-text-secondary);
    font: var(--clv-text-label);
    letter-spacing: 0.06em;
  }

  .mail {
    font: 600 clamp(1.5rem, 1rem + 1.6vw, 2.1rem) / 1.1 var(--clv-font-display);
    font-variation-settings: var(--clv-heading-vars);
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }

  .form {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--clv-glass-border);
    border-radius: calc(var(--clv-radius) * 1.5);
    background: var(--clv-glass);
    backdrop-filter: blur(22px) saturate(1.7);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9) inset, 0 18px 40px -24px rgba(26, 28, 30, 0.25);
  }

  .form label {
    display: grid;
    gap: 0.4rem;
  }

  .form label span {
    color: var(--clv-text-secondary);
    font: var(--clv-text-label);
    letter-spacing: 0.06em;
  }

  .form input:not([type="hidden"]),
  .form textarea {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--clv-border);
    border-radius: var(--clv-radius);
    background: rgba(255, 255, 255, 0.85);
    color: var(--clv-text);
    font: var(--clv-text-body);
    resize: vertical;
    transition: border-color var(--dur-1) var(--ease-std), background-color var(--dur-1) var(--ease-std);
  }

  .form input:hover,
  .form textarea:hover {
    border-color: var(--clv-text-secondary);
  }

  .form input:focus-visible,
  .form textarea:focus-visible {
    outline: none;
    border-color: var(--clv-text);
    background: var(--clv-blanc);
    box-shadow: 0 0 0 3px rgba(47, 191, 113, 0.28);
  }

  .form__trap {
    position: absolute;
    left: -9999px;
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.25rem;
  }

  .form__foot .btn { cursor: pointer; border: 0; min-width: 9rem; }
  .form__foot .btn:disabled { opacity: 0.6; cursor: default; }
  .form__status { margin: 0; font-size: 1rem; }
  .form__status[data-state="error"] { color: var(--clv-error); }

  @media (min-width: 900px) {
    .cierre__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas:
        "texto form"
        "mail form";
      column-gap: clamp(2.5rem, 6vw, 5rem);
      row-gap: 2.5rem;
    }
    .cierre__texto { grid-area: texto; }
    .form { grid-area: form; }
    .cierre__mail { grid-area: mail; align-self: end; }
  }

  #como, #trabajo, #contacto { scroll-margin-top: 5.5rem; }

  .filas li:not(:has(.meta)) {
    grid-template-columns: 2.75rem minmax(0, 1fr);
  }

  /* Móvil: más aire, tipografía un poco más pequeña, menos apretado.
     Escritorio (≥800px) se queda como está. */
  @media (max-width: 799px) {
    .cartel__grid {
      row-gap: 1.4rem;
      padding-block: 2.25rem 2.75rem;
    }

    h1 {
      font-size: clamp(1.85rem, 1.15rem + 3.2vw, 2.35rem);
      line-height: 1.08;
    }

    .lede {
      font-size: 1.05rem;
      line-height: 1.55;
      max-width: 28rem;
    }

    .acciones {
      gap: 10px 18px;
      margin-top: 0.25rem;
    }

    .salto {
      font-size: 1rem;
    }

    .bloque {
      padding-block: 3.75rem;
    }

    .bloque h2 {
      font-size: clamp(1.55rem, 1.2rem + 1.8vw, 1.85rem);
      line-height: 1.15;
    }

    .intro {
      margin-top: 1rem;
      font-size: 1.05rem;
      line-height: 1.55;
    }

    .filas {
      margin-top: 2rem;
    }

    .filas li {
      grid-template-columns: 2.35rem minmax(0, 1fr);
      column-gap: 0.85rem;
      padding: 1.45rem 0;
    }

    .filas li:not(:has(.meta)) {
      grid-template-columns: 2.35rem minmax(0, 1fr);
    }

    .filas--resto li {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 1.55rem;
    }

    .num {
      padding-top: 0.3rem;
      font-size: 11px;
    }

    .filas h3 {
      font-size: 1.2rem;
      line-height: 1.25;
    }

    .filas p {
      margin-top: 0.5rem;
      font-size: 1rem;
      line-height: 1.55;
    }

    .filas--resto .abre summary {
      column-gap: 0.65rem;
      row-gap: 0.5rem;
    }

    .filas--resto .abre summary .meta {
      font-size: 11px;
      letter-spacing: 0.05em;
    }

    .abre__mas {
      width: 40px;
      height: 40px;
      margin-top: -0.2rem;
    }

    .abre__cuerpo {
      margin-top: 1rem;
      padding-top: 1rem;
    }

    .abre__cuerpo p + p {
      margin-top: 0.7rem;
    }

    .cierre__linea {
      font-size: 1.05rem;
      line-height: 1.55;
    }

    #como,
    #trabajo,
    #contacto {
      scroll-margin-top: 5rem;
    }
  }

  @media (min-width: 800px) {
    .filas li {
      grid-template-columns: 3rem minmax(0, 1fr) 12rem;
      column-gap: 1.5rem;
    }
    .filas li:not(:has(.meta)) {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .meta {
      grid-column: auto;
      margin-top: 0;
      padding-top: 0.45rem;
      text-align: right;
    }

    .filas--resto li {
      grid-template-columns: minmax(0, 1fr);
    }

    .filas--resto .abre summary {
      grid-template-columns: minmax(0, 1fr) 12rem auto;
      grid-template-areas: "texto meta mas";
      column-gap: 1.5rem;
    }

    .filas--resto .abre summary .meta {
      padding-top: 0.45rem;
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .abre__icon {
      transition: none;
    }

    h1 span,
    .lede,
    .acciones {
      animation: none;
    }
  }

</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  if (form) {
    const status = form.querySelector<HTMLElement>(".form__status")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.dataset.state = "";
      status.textContent = form.dataset.sending ?? "";
      try {
        const res = await fetch(form.action, { method: "POST", body: new FormData(form) });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = form.dataset.ok ?? "";
      } catch {
        status.dataset.state = "error";
        status.textContent = form.dataset.error ?? "";
      } finally {
        button.disabled = false;
      }
    });
  }

  document.querySelectorAll("#trabajo details.abre").forEach((el) => {
    el.addEventListener("toggle", () => {
      if (!(el instanceof HTMLDetailsElement) || !el.open) return;
      document.querySelectorAll("#trabajo details.abre[open]").forEach((other) => {
        if (other !== el && other instanceof HTMLDetailsElement) {
          other.open = false;
        }
      });
    });
  });
</script>
