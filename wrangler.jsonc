{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe coincidir con el Worker name del CI de Cloudflare ("web").
  "name": "web",
  "compatibility_date": "2025-11-06",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
